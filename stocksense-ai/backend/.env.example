# ── StockSense AI / BursaSense — copy to .env and edit ────────────────────────
# DEMO_MODE=true works with zero paid accounts — synthetic KLSE data only.

# App
APP_NAME=StockSense AI
API_PREFIX=/api
DEBUG=false

# Demo / offline mode (no moomoo / yfinance / API keys required)
DEMO_MODE=true

# Read-only deployment (public demo): refuse orders, kill-switch writes,
# and agent sessions. Keep false for the local paper stack.
READ_ONLY_MODE=false

# ClickHouse — OHLCV / indicators / sentiment / backtest history
# docker-compose sets CLICKHOUSE_HOST=clickhouse automatically
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=stocksense
CLICKHOUSE_PASSWORD=stocksense_ch
CLICKHOUSE_DB=stocksense
CLICKHOUSE_ENABLED=true

# Supabase — auth / user data / training jobs / watchlists
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Redis
REDIS_URL=redis://localhost:6379
CACHE_DATASET_TTL=900
CACHE_PREDICT_TTL=300

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Data sources
NEWS_API_KEY=your-newsapi-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockSense AI v1.0

# Auth
SECRET_KEY=change-this-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# moomoo OpenD (Phase 2 — leave MOOMOO_ENABLED=false for demo mode)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_ENABLED=false

# moomoo paper trading — SIMULATE only. Live environments are rejected.
# MOOMOO_PAPER_ACCOUNT_ID comes from the sim account (acc_id) in moomoo.
MOOMOO_TRADE_ENABLED=false
MOOMOO_TRD_ENV=SIMULATE
MOOMOO_PAPER_ACCOUNT_ID=
MOOMOO_TRD_MARKET=US
MOOMOO_SECURITY_FIRM=FUTUSECURITIES

# Pre-trade risk limits (fractions of account equity)
RISK_MAX_POSITION_PCT=0.25
RISK_MAX_GROSS_EXPOSURE_PCT=0.90
RISK_MAX_ORDER_NOTIONAL=50000
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.15
RISK_MIN_CASH_BUFFER_PCT=0.10

# Decision ledger fallback + kill-switch auth
DECISION_LEDGER_JSONL=data/decision_ledger.jsonl
PORTFOLIO_HISTORY_JSONL=data/portfolio_history.jsonl
ADMIN_API_TOKEN=change-this-to-a-separate-ops-token

# ML
ANOMALY_CONTAMINATION=0.08
DIRECTION_THRESHOLD=0.60
DEFAULT_TICKERS=["NVDA","MAYBANK.KL","PBBANK.KL"]
MODELS_DIR=./models

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

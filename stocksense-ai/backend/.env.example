# App
APP_NAME=StockSense AI
API_PREFIX=/api
DEBUG=false

# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Redis
REDIS_URL=redis://localhost:6379
CACHE_DATASET_TTL=900
CACHE_PREDICT_TTL=300

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Data sources
NEWS_API_KEY=your-newsapi-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockSense AI v1.0

# Auth
SECRET_KEY=change-this-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# moomoo
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_ENABLED=true

# ML
ANOMALY_CONTAMINATION=0.08
DIRECTION_THRESHOLD=0.60
DEFAULT_TICKERS=["NVDA","MAYBANK.KL","PBBANK.KL"]
MODELS_DIR=./models

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://stocksense-ai.vercel.app"]

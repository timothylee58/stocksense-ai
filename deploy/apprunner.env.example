# App Runner → Configuration → Environment variables (key/value pairs).
# Paste these in the console, or pass the same keys to
# aws apprunner update-service --source-configuration.
# Replace every <...> placeholder before pasting. Never commit real secrets.

# Fail closed: no synthetic data, no live order path.
DEMO_MODE=false
MOOMOO_ENABLED=false
MOOMOO_TRADE_ENABLED=false
MOOMOO_TRD_ENV=SIMULATE

# Read-only demo: predictions, dashboard, ledger display. Order submission,
# kill-switch writes, and agent sessions are refused with 403 READ_ONLY_MODE.
READ_ONLY_MODE=true

# Required secrets (generate/choose locally).
SECRET_KEY=<openssl rand -hex 32>
ADMIN_API_TOKEN=<separate ops token for POST /api/agents/run>

# CORS: JSON array, must contain the Vercel production origin exactly.
ALLOWED_ORIGINS=["https://<project>.vercel.app"]

# No ClickHouse / Redis in the cloud yet — leave disabled so ledger reads fall
# back to JSONL instead of timing out against localhost.
CLICKHOUSE_ENABLED=false
# REDIS_URL is only set once ElastiCache (or equivalent) exists; the cache
# layer fails open, so an absent Redis only costs latency.

# ML artifacts path inside the container (requires models/ in the image).
MODELS_DIR=./models

# Optional until provisioned — endpoints degrade by design when unset.
# ANTHROPIC_API_KEY=
# NEWS_API_KEY=
